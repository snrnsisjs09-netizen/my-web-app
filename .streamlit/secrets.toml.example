# 이 파일을 같은 폴더에 secrets.toml 이라는 이름으로 복사해서 씁니다.
# secrets.toml 은 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다. 이 예시 파일에는 실제 비밀번호를 적지 않습니다.

[connections.sql]
# ① 내 PC 파일 (SQLite) — 처음에는 이 줄을 씁니다.
url = "sqlite:///data/app.db"

# ② Supabase — Lab 5에서 위 줄 앞에 # 를 붙이고 아래 줄의 # 를 지운 뒤 주소를 바꿉니다.
#    Supabase 프로젝트 ▸ Connect ▸ Session pooler 주소를 복사하고 [YOUR-PASSWORD] 자리에 DB 비밀번호를 넣습니다.
# url = "postgresql://postgres.<프로젝트ID>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
